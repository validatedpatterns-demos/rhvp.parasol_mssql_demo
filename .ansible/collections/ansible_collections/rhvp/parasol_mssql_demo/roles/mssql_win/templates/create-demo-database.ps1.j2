$ErrorActionPreference = 'Stop'
$saPassword = '{{ mssql_win_sa_password | replace("'", "''") }}'
$database = '{{ mssql_win_database }}'
$dataRoot = '{{ mssql_win_data_root }}'
$conn = New-Object System.Data.SqlClient.SqlConnection
$conn.ConnectionString = "Data Source=localhost;User ID=sa;Password=$saPassword;Initial Catalog=master;Encrypt=False"
$conn.Open()
$cmd = $conn.CreateCommand()
if ($dataRoot) {
  $dataDir = Join-Path $dataRoot 'Data'
  $logDir = Join-Path $dataRoot 'Log'
  New-Item -ItemType Directory -Force -Path $dataDir, $logDir | Out-Null
  $mdf = Join-Path $dataDir ($database + '.mdf')
  $ldf = Join-Path $logDir ($database + '_log.ldf')
  $mdfSql = $mdf.Replace("'", "''")
  $ldfSql = $ldf.Replace("'", "''")
  $cmd.CommandText = @"
IF DB_ID(N'$database') IS NULL
BEGIN
  CREATE DATABASE [$database] ON PRIMARY (
    NAME = N'$database',
    FILENAME = N'$mdfSql'
  ) LOG ON (
    NAME = N'$($database)_log',
    FILENAME = N'$ldfSql'
  );
  SELECT 'created' AS result
END
ELSE
BEGIN
  SELECT 'exists' AS result
END
"@
} else {
  $cmd.CommandText = @"
IF DB_ID(N'$database') IS NULL
BEGIN
  CREATE DATABASE [$database];
  SELECT 'created' AS result
END
ELSE
BEGIN
  SELECT 'exists' AS result
END
"@
}
$result = $cmd.ExecuteScalar()
$conn.Close()
Write-Output $result
