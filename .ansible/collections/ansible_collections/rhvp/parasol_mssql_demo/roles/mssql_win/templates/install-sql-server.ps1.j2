# Runs inside a Scheduled Task (loaded user profile) so SQL Setup DPAPI works.
$ErrorActionPreference = 'Continue'
$log = '{{ mssql_win_install_log }}'
$marker = '{{ mssql_win_install_marker }}'
$choco = 'C:\ProgramData\chocolatey\bin\choco.exe'

# Single-quoted here-string keeps Setup switches intact for Chocolatey.
$pkgParams = @'
{{ mssql_win_setup_params }}
'@

$argList = @(
  'install',
  '{{ mssql_win_chocolatey_package }}',
  '--fail-on-unfound',
  '--yes',
  '--no-progress',
  '--limit-output',
  '--package-parameters', $pkgParams.Trim(),
  '--source', '{{ mssql_win_chocolatey_source }}',
  '--timeout', '{{ mssql_win_setup_timeout }}'
)

& $choco @argList *>&1 | Tee-Object -FilePath $log
$code = $LASTEXITCODE
Set-Content -Path $marker -Value $code -Encoding ASCII
exit $code
