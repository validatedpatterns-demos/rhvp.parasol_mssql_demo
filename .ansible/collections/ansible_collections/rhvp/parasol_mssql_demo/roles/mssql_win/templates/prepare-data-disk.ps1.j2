$ErrorActionPreference = 'Stop'
$letter = '{{ mssql_win_data_drive_letter }}'
$label = '{{ mssql_win_data_disk_label }}'
if (-not $letter) {
  throw 'mssql_win_data_drive_letter is empty'
}
$rootPath = $letter + ':\'
if (Test-Path -LiteralPath $rootPath) {
  Write-Output 'present'
  exit 0
}

$disk = Get-Disk |
  Where-Object { -not $_.IsSystem -and -not $_.IsBoot -and $_.PartitionStyle -eq 'Raw' } |
  Sort-Object Number |
  Select-Object -First 1
if (-not $disk) {
  # Previously partially initialized secondary disk (no usable Basic volume yet).
  $disk = Get-Disk |
    Where-Object {
      -not $_.IsSystem -and -not $_.IsBoot -and
      -not (
        Get-Partition -DiskNumber $_.Number -ErrorAction SilentlyContinue |
          Where-Object { $_.Type -eq 'Basic' -and $_.DriveLetter }
      )
    } |
    Sort-Object Number |
    Select-Object -First 1
}
if (-not $disk) {
  throw ('No secondary disk available to assign drive letter ' + $letter + ':')
}

if ($disk.IsOffline) {
  Set-Disk -Number $disk.Number -IsOffline $false
}
if ($disk.IsReadOnly) {
  Set-Disk -Number $disk.Number -IsReadOnly $false
}

# Clear a partial GPT (MSR/EFI only) so we can create a clean data volume.
$basic = Get-Partition -DiskNumber $disk.Number -ErrorAction SilentlyContinue |
  Where-Object { $_.Type -eq 'Basic' -and $_.Size -gt 1GB }
if ($disk.PartitionStyle -eq 'Raw') {
  Initialize-Disk -Number $disk.Number -PartitionStyle GPT | Out-Null
} elseif (-not $basic) {
  Clear-Disk -Number $disk.Number -RemoveData -Confirm:$false
  Initialize-Disk -Number $disk.Number -PartitionStyle GPT | Out-Null
}

$part = Get-Partition -DiskNumber $disk.Number -ErrorAction SilentlyContinue |
  Where-Object { $_.Type -eq 'Basic' -and $_.Size -gt 1GB } |
  Select-Object -First 1
if (-not $part) {
  $part = New-Partition -DiskNumber $disk.Number -UseMaximumSize -DriveLetter $letter
} elseif (-not $part.DriveLetter) {
  Set-Partition -DiskNumber $disk.Number -PartitionNumber $part.PartitionNumber -NewDriveLetter $letter
  $part = Get-Partition -DiskNumber $disk.Number -PartitionNumber $part.PartitionNumber
} elseif ($part.DriveLetter -ne $letter) {
  # Free the desired letter if something else holds it, then reassign.
  $conflict = Get-Partition | Where-Object { $_.DriveLetter -eq $letter }
  if ($conflict) {
    Remove-PartitionAccessPath -DiskNumber $conflict.DiskNumber `
      -PartitionNumber $conflict.PartitionNumber `
      -AccessPath ($letter + ':\')
  }
  Set-Partition -DiskNumber $disk.Number -PartitionNumber $part.PartitionNumber -NewDriveLetter $letter
  $part = Get-Partition -DiskNumber $disk.Number -PartitionNumber $part.PartitionNumber
}

$vol = Get-Volume -Partition $part -ErrorAction SilentlyContinue
if (-not $vol -or -not $vol.FileSystem) {
  Format-Volume -Partition $part -FileSystem NTFS -NewFileSystemLabel $label -Confirm:$false | Out-Null
}

if (-not (Test-Path -LiteralPath $rootPath)) {
  throw ('Data volume was prepared but ' + $rootPath + ' is still missing')
}
Write-Output 'created'
