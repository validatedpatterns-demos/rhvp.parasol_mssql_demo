---
# Copy to a non-committed path and encrypt before use, for example:
#   cp examples/vault.yml.example ~/vault-parasol.yml
#   ansible-vault encrypt ~/vault-parasol.yml
#   ansible-playbook -i examples/inventory-edge-gitops-vms.yml \
#     -e @~/vault-parasol.yml --ask-vault-pass playbooks/site.yml
#
# Replace every REPLACE_ME value. Never commit the filled-in file.

vault_win_admin_password: "REPLACE_ME"
vault_mssql_sa_password: "REPLACE_ME"
# Optional — only if the RHEL cloud-init user uses password auth:
vault_rhel_password: "REPLACE_ME"
# Optional — only if quadlet_app_rhsm_register is enabled:
# vault_rhsm_org_id: "REPLACE_ME"
# vault_rhsm_activation_key: "REPLACE_ME"
